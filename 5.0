using BepInEx;
using UnityEngine;
using GorillaLocomotion;

namespace BillyChecker
{
    [BepInPlugin("com.christian.billychecker", "BillyChecker", "1.0.0")]
    public class Class1 : BaseUnityPlugin
    {
        private bool showMenu = false;
        private Rect windowRect = new Rect(20, 20, 250, 300);
        private bool buttonWasPressed = false;

        private void Update()
        {
            // Checks if the left controller's X button (Primary Button) is pressed down
            bool xPressed = ControllerInputPoller.instance.leftControllerPrimaryButton;

            if (xPressed && !buttonWasPressed)
            {
                showMenu = !showMenu;
                PlayClickSound();
            }
            buttonWasPressed = xPressed;

            // Optional keyboard fallback (F1) for flat-screen testing
            if (Input.GetKeyDown(KeyCode.F1))
            {
                showMenu = !showMenu;
                PlayClickSound();
            }
        }

        private void OnGUI()
        {
            if (showMenu)
            {
                // If Player/Rig is loaded, lock the menu near the left hand position in world/screen space
                if (Player.Instance != null)
                {
                    Vector3 leftHandPos = Player.Instance.leftControllerTransform.position;
                    // Project world position to screen space for IMGUI rendering
                    Vector3 screenPos = Camera.main.WorldToScreenPoint(leftHandPos + new Vector3(0, 0.2f, 0));
                    windowRect.x = screenPos.x;
                    windowRect.y = Screen.height - screenPos.y;
                }

                windowRect = GUI.Window(999, windowRect, DrawMenuWindow, "BillyChecker Menu");
            }
        }

        private void DrawMenuWindow(int windowID)
        {
            GUILayout.BeginVertical();
            GUILayout.Label("--- BillyChecker VR ---");

            if (GUILayout.Button("Functional Button 1"))
            {
                PlayClickSound();
                Debug.Log("Button 1 Clicked!");
            }

            if (GUILayout.Button("Close Menu"))
            {
                PlayClickSound();
                showMenu = false;
            }

            GUILayout.EndVertical();
            GUI.DragWindow();
        }

        private void PlayClickSound()
        {
            try
            {
                // Plays the standard Gorilla Tag menu click sound effect if the player instance exists
                if (Player.Instance != null && Player.Instance.rightControllerTransform != null)
                {
                    // Plays a standard UI click sound clip via Gorilla Tag audio source
                    AudioSource.PlayClipAtPoint(Player.Instance.jumpSound, Player.Instance.leftControllerTransform.position, 0.5f);
                }
            }
            catch
            {
                // Fallback if audio trigger fails safely
            }
        }
    }
}
